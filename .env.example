# Copy to .env for Docker or set these securely in your hosting platform.
# Use a long, randomly generated value; never commit the real secret.
TRIGUARD_ENV=production
TRIGUARD_API_KEY=replace-with-a-long-random-secret
# Required for the signed-in planner dashboard. Generate a distinct, long random value.
TRIGUARD_SESSION_SECRET=replace-with-a-long-random-session-secret
# Used only once to create the first dashboard account in a new database.
TRIGUARD_ADMIN_EMAIL=planner@example.com
TRIGUARD_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Enable public sign-up only together with the SMTP and HTTPS settings below.
TRIGUARD_ALLOW_SELF_SIGNUP=false
# Email verification for public self-service registration.
# In local development use TRIGUARD_EMAIL_DELIVERY=console; the verification link appears on the page.
TRIGUARD_PUBLIC_BASE_URL=https://your-domain.example
TRIGUARD_EMAIL_DELIVERY=smtp
TRIGUARD_EMAIL_FROM=no-reply@your-domain.example
TRIGUARD_SMTP_HOST=smtp.your-email-provider.example
TRIGUARD_SMTP_PORT=587
TRIGUARD_SMTP_USERNAME=replace-with-smtp-username
TRIGUARD_SMTP_PASSWORD=replace-with-smtp-password
TRIGUARD_SMTP_STARTTLS=true
TRIGUARD_VERIFICATION_TTL_MINUTES=1440
# For managed PostgreSQL, use: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Leave this local SQLite default in place for development.
TRIGUARD_DATABASE_URL=sqlite:////app/outputs/database/triguard.db
# Leave empty for server-to-server clients. List only approved browser origins if needed.
TRIGUARD_ALLOWED_ORIGINS=
TRIGUARD_MAX_BATCH_SIZE=500
TRIGUARD_MAX_REQUEST_BYTES=1048576
# Set these only when the API is behind a trusted reverse proxy; use the number of trusted hops.
TRIGUARD_PROXY_FIX_X_FOR=0
TRIGUARD_PROXY_FIX_X_PROTO=0
TRIGUARD_PROXY_FIX_X_HOST=0
# Optional comma-separated host allowlist, for example: api.example.org
TRIGUARD_TRUSTED_HOSTS=
TRIGUARD_LOG_LEVEL=INFO
# Optional: redirect audit events to managed persistent storage.
# TRIGUARD_AUDIT_LOG=/app/outputs/audit/prediction_events.jsonl
